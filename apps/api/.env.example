NODE_ENV=development
PORT=3001

# CORS origin allowed to call this API in development (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000

# Dedicated Kestro development database, provided by ../../docker-compose.yml.
# Never point this at any shared/staging/production database.
DATABASE_URL=postgresql://kestro:opsflow_dev_password@localhost:5433/kestro_dev
