NODE_ENV=development
PORT=3001

# CORS origin allowed to call this API in development (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000

# Dedicated Kestro development database, provided by ../../docker-compose.yml.
# Never point this at any shared/staging/production database.
DATABASE_URL=postgresql://kestro:opsflow_dev_password@localhost:5433/kestro_dev

# Distinct secrets required (min 32 chars each) — generate with:
#   openssl rand -hex 32
# Access and refresh tokens must never share a secret. Never commit real
# secrets; these are placeholders only.
JWT_ACCESS_SECRET=replace-with-a-generated-32-byte-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-generated-32-byte-hex-secret
JWT_REFRESH_EXPIRES_IN=30d
