// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  analyst
  lead

  @@map("user_role")
}

// Shared severity scale for alerts.severity and cases.severity (docs/ARCHITECTURE.md
// documents identical value sets for both columns).
enum Severity {
  low
  medium
  high
  critical

  @@map("severity")
}

enum AlertStatus {
  new
  linked
  dismissed

  @@map("alert_status")
}

enum CaseStatus {
  OPEN
  TRIAGING
  INVESTIGATING
  ESCALATED
  MITIGATING
  VERIFYING
  RESOLVED

  @@map("case_status")
}

enum TimelineEventType {
  note
  status_change
  evidence_added
  comment
  alert_linked

  @@map("timeline_event_type")
}

enum EvidenceType {
  LOG
  SCREENSHOT
  FILE
  URL
  COMMAND_OUTPUT
  OTHER

  @@map("evidence_type")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole
  // Soft-delete: a disabled user is blocked from login/refresh but the row
  // is kept permanently so case/evidence/timeline attribution never breaks
  // (docs/SECURITY.md's append-only audit trail requires authors stay
  // identifiable). Null means active.
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assignedCases          Case[]
  authoredTimelineEvents TimelineEvent[]
  authoredEvidence       Evidence[]
  refreshTokens          RefreshToken[]
  dismissedAlerts        Alert[]

  @@map("users")
}

// Server-side record of an issued refresh token, keyed by the JWT's own
// `jti` claim. The token's authenticity is verified by its signature, not by
// this table — this row exists only to make revocation and rotation
// possible for an otherwise-stateless JWT (docs/ARCHITECTURE.md auth
// decisions: refresh tokens are server-side revocable; no access-token
// denylist).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Alert {
  id            String      @id @default(uuid()) @db.Uuid
  source        String
  summary       String
  rawPayload    Json?       @map("raw_payload")
  severity      Severity
  status        AlertStatus @default(new)
  dismissReason String?     @map("dismiss_reason")
  // Dismissal audit fields (docs/SECURITY.md requires who/what/when for
  // alert dismissal). Not modeled via timeline_events: that table requires
  // a case_id, and a dismissed alert — by definition of the triage decision
  // in docs/WORKFLOW.md — never has one. Required together with
  // dismissReason when status = dismissed, null otherwise (see the
  // alerts_dismissal_fields_status_check constraint).
  dismissedById String?     @map("dismissed_by_id") @db.Uuid
  dismissedAt   DateTime?   @map("dismissed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  dismissedBy User?      @relation(fields: [dismissedById], references: [id], onDelete: Restrict)
  caseAlert   CaseAlert?

  @@map("alerts")
}

model Case {
  id                String     @id @default(uuid()) @db.Uuid
  title             String
  status            CaseStatus @default(OPEN)
  severity          Severity
  assigneeId        String     @map("assignee_id") @db.Uuid
  resolutionSummary String?    @map("resolution_summary")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  assignee       User            @relation(fields: [assigneeId], references: [id])
  caseAlerts     CaseAlert[]
  timelineEvents TimelineEvent[]
  evidence       Evidence[]

  @@index([status])
  @@index([assigneeId])
  @@map("cases")
}

model CaseAlert {
  id       String   @id @default(uuid()) @db.Uuid
  caseId   String   @map("case_id") @db.Uuid
  alertId  String   @unique @map("alert_id") @db.Uuid
  linkedAt DateTime @default(now()) @map("linked_at")

  case  Case  @relation(fields: [caseId], references: [id])
  alert Alert @relation(fields: [alertId], references: [id])

  @@index([caseId])
  @@map("case_alerts")
}

model TimelineEvent {
  id        String            @id @default(uuid()) @db.Uuid
  caseId    String            @map("case_id") @db.Uuid
  type      TimelineEventType
  authorId  String            @map("author_id") @db.Uuid
  content   Json
  createdAt DateTime          @default(now()) @map("created_at")

  case     Case       @relation(fields: [caseId], references: [id])
  author   User       @relation(fields: [authorId], references: [id])
  evidence Evidence[]

  @@index([caseId, createdAt])
  @@map("timeline_events")
}

model Evidence {
  id              String       @id @default(uuid()) @db.Uuid
  caseId          String       @map("case_id") @db.Uuid
  timelineEventId String       @map("timeline_event_id") @db.Uuid
  type            EvidenceType
  source          String
  content         String
  timestamp       DateTime
  authorId        String       @map("author_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")

  case          Case          @relation(fields: [caseId], references: [id])
  timelineEvent TimelineEvent @relation(fields: [timelineEventId], references: [id])
  author        User          @relation(fields: [authorId], references: [id])

  @@index([caseId])
  @@index([timelineEventId])
  @@map("evidence")
}
