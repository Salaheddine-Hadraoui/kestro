# Credentials for the dedicated Kestro development PostgreSQL container
# (docker-compose.yml). LOCAL DEVELOPMENT ONLY — this database is isolated
# from any other PostgreSQL installation on the host or elsewhere. Never
# point this at a shared, staging, or production database, and never commit
# real secrets here (these are throwaway dev-only defaults).
POSTGRES_USER=kestro
POSTGRES_PASSWORD=opsflow_dev_password
POSTGRES_DB=kestro_dev
POSTGRES_PORT=5433
